{
  "name": "openclaw-armada-dm",
  "version": "0.1.0",
  "description": "OpenClaw channel plugin for private Armada NIP-17 direct messages",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write AGENTS.md README.md SECURITY.md package.json openclaw.plugin.json tsconfig.json tsconfig.lint.json eslint.config.js index.ts setup-entry.ts scripts src docs .github",
    "format:check": "prettier --check AGENTS.md README.md SECURITY.md package.json openclaw.plugin.json tsconfig.json tsconfig.lint.json eslint.config.js index.ts setup-entry.ts scripts src docs .github",
    "package:validate": "npm run build && node scripts/validate-package.mjs",
    "package:dry-run": "npm --cache /tmp/armada-bot-npm-cache pack --dry-run --json",
    "sdk:baseline": "node scripts/validate-sdk-imports.mjs",
    "smoke:built": "node scripts/smoke-built-artifact.mjs",
    "smoke:package": "node scripts/smoke-packed-artifact.mjs",
    "smoke:install": "node scripts/smoke-install-paths.mjs",
    "audit": "npm audit --omit=dev --audit-level=low",
    "ci": "npm test && npm run lint && npm run typecheck && npm run format:check && npm run package:validate && npm run sdk:baseline && npm run smoke:built && npm run smoke:package && npm run smoke:install && npm run package:dry-run && npm run audit"
  },
  "dependencies": {
    "nostr-tools": "2.25.0",
    "ws": "8.21.0",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "openclaw": ">=2026.6.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.3.0",
    "@types/ws": "8.18.1",
    "eslint": "10.9.1",
    "openclaw": "2026.6.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT",
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "setupEntry": "./dist/setup-entry.js",
    "channel": {
      "id": "nostr",
      "label": "Armada DM",
      "selectionLabel": "Armada DM (Nostr NIP-17)",
      "detailLabel": "Nostr private direct messages",
      "docsPath": "/channels/nostr",
      "docsLabel": "Armada DM",
      "blurb": "Private one-to-one Armada messages over NIP-17.",
      "markdownCapable": true
    },
    "install": {
      "npmSpec": "openclaw-armada-dm",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.6.1"
    },
    "compat": {
      "pluginApi": ">=2026.6.1"
    },
    "build": {
      "openclawVersion": "2026.6.1",
      "pluginSdkVersion": "2026.6.1"
    }
  }
}
